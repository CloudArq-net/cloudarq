{
  "@odata.type": "#microsoft.graph.federatedIdentityCredential",
  "name": "github-infra-any-branch",
  "issuer": "https://token.actions.githubusercontent.com",
  "subject": null,
  "audiences": [
    "api://AzureADTokenExchange"
  ],
  "claimsMatchingExpression": {
    "value": "claims['sub'] matches 'repo:acme/infra:*' and claims['repository_id'] eq '456789'",
    "languageVersion": 1
  },
  "description": "one repo, any branch; AWS states it with ForAllValues, which no other provider can"
}
