{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AnyoneFromOneSourceAccount",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "123456789012"
        }
      }
    }
  ]
}
