{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitLabProjectByID",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/gitlab.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "gitlab.com:aud": "https://gitlab.com"
        },
        "StringLike": {
          "gitlab.com:sub": "project_id:4815162342:*"
        }
      }
    }
  ]
}
