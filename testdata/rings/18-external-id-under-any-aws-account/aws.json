{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AnyAccountWithTheExternalID",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "vendor-abc"
        }
      }
    }
  ]
}
