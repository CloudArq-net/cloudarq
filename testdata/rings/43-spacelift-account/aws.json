{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SpaceliftAccount",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/acme.app.spacelift.io"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "acme.app.spacelift.io:aud": "acme.app.spacelift.io"
        }
      }
    }
  ]
}
