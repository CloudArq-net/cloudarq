{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RolesOfOneAccount",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringLike": {
          "aws:PrincipalArn": "arn:aws:iam::111122223333:role/*"
        }
      }
    },
    {
      "Sid": "AccountNotClosed",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringLike": {
          "aws:PrincipalArn": "arn:aws:iam::11112222333*"
        }
      }
    }
  ]
}
