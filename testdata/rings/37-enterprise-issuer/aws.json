{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnterpriseIssuer",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com/acme-ent"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com/acme-ent:aud": "sts.amazonaws.com"
        }
      }
    }
  ]
}
