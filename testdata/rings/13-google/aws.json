{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GoogleAudience",
      "Effect": "Allow",
      "Principal": {
        "Federated": "accounts.google.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "accounts.google.com:aud": "123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com"
        }
      }
    }
  ]
}
