{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VariableInTheClaimPosition",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:${aws:username}": "x"
        }
      }
    },
    {
      "Sid": "VariableInTheProviderPosition",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "${aws:PrincipalTag/provider}:sub": "repo:acme/infra:ref:refs/heads/main"
        }
      }
    }
  ]
}
