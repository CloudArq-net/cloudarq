{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProviderRegisteredWithATrailingSlash",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/acme.eu.auth0.com/"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "acme.eu.auth0.com/:aud": "AbCdEf0123456789"
        }
      }
    },
    {
      "Sid": "KeyWithoutTheSlashNamesAnotherProvider",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/acme.eu.auth0.com/"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "acme.eu.auth0.com:aud": "AbCdEf0123456789"
        }
      }
    }
  ]
}
