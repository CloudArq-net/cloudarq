{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmptyStringEqualsBesideAnAudience",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringLike": {
          "token.actions.githubusercontent.com:sub": "repo:acme/*"
        },
        "StringEquals": {}
      }
    },
    {
      "Sid": "EmptyUnrecognisedOperator",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "ArnLike": {}
      }
    },
    {
      "Sid": "DenyWithAnEmptyBlock",
      "Effect": "Deny",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEqualsIfExists": {}
      }
    }
  ]
}
