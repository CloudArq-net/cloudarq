#!/usr/bin/env bash
# Blocks co-author trailers and tool attribution in commit messages.
# Install: cp scripts/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
set -euo pipefail
msg_file="$1"
pattern='co-authored-by|generated with|generated by|assisted by|on-behalf-of'
if grep -qiE "$pattern" "$msg_file"; then
  echo "commit blocked: attribution trailer found in the commit message." >&2
  grep -inE "$pattern" "$msg_file" >&2
  echo "Remove it. Every commit in this repository is authored by a human alone." >&2
  exit 1
fi
